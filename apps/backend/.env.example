AUTH_THROTTLE_LIMIT="5"
SEND_CODE_THROTTLE_LIMIT="3"
JOIN_THROTTLE_LIMIT="10"
SOS_THROTTLE_LIMIT="5"

# Seed only, read by prisma/seed.ts (not in the boot schema, PRD 8.14)
